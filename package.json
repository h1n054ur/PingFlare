{
  "name": "pingflare",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build && wrangler dev",
    "dev:remote": "wrangler dev --remote",
    "build": "vite build",
    "deploy": "bun run db:migrate:remote && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply pingflare_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply pingflare_db --remote",
    "types": "wrangler types",
    "tail": "wrangler tail",
    "lint": "eslint web/src --ext .ts,.tsx",
    "format": "prettier --write web/src/**/*.{ts,tsx,css}"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@hono/zod-validator": "^0.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.7.3",
    "better-auth-cloudflare": "^0.3.1",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "i18next": "^26.0.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.0",
    "react-router-dom": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^4.0.0",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.129.0"
  }
}
